{
  "name": "@markup-carve/carve-css",
  "version": "0.1.1",
  "description": "Stylesheet for the HTML the Carve markup language renders - admonitions, tab sets, code groups, callouts, figures, footnotes, glossary and index",
  "keywords": ["carve", "markup", "css", "stylesheet", "theme"],
  "license": "MIT",
  "author": "Mark Scherer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markup-carve/carve-css.git"
  },
  "bugs": {
    "url": "https://github.com/markup-carve/carve-css/issues"
  },
  "homepage": "https://markup-carve.github.io/carve/",
  "type": "module",
  "style": "src/carve.css",
  "main": "src/carve.css",
  "exports": {
    ".": "./src/carve.css",
    "./tokens.css": "./src/tokens.css",
    "./core.css": "./src/core.css",
    "./extensions.css": "./src/extensions.css",
    "./contrast.css": "./src/contrast.css",
    "./recipes.css": "./src/recipes.css",
    "./print.css": "./src/print.css",
    "./package.json": "./package.json"
  },
  "files": ["src"],
  "sideEffects": ["*.css"],
  "scripts": {
    "test": "npm run test:coverage && npm run test:quality",
    "test:coverage": "node scripts/check-coverage.mjs",
    "test:quality": "node scripts/check-quality.mjs",
    "test:browsers": "playwright test"
  },
  "devDependencies": {
    "@markup-carve/carve": "^0.1.4",
    "@playwright/test": "^1.55.0"
  }
}
